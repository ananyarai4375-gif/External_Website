# Backend configuration (Render/Railway environment variables)
PORT=8000
HOST=0.0.0.0
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
CORS_ORIGINS=http://localhost:8000,https://my-movie-demo.vercel.app
MAX_ACTIVE_USERS=50
VM_CAPACITY=10
MAX_SIMULATED_VMS=5
SESSION_TIMEOUT_SECONDS=60
SCALE_DOWN_AFTER_SECONDS=120

# Frontend build configuration (Vercel environment variables)
VITE_API_BASE_URL=https://your-backend.onrender.com

# Never place database passwords or private API keys in VITE_* variables.